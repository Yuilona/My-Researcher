generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaperProject {
  id                   String                @id
  titleCardId          String                @map("topicId")
  title                String
  researchDirection    String
  status               String
  paperActiveSpFull    String?
  paperActiveSpPartial String?
  createdAt            DateTime              @db.Timestamptz(6)
  nodes                StageNode[]
  snapshots            Snapshot[]
  literatureLinks      PaperLiteratureLink[]
}

model StageNode {
  id              String       @id
  paperId         String
  stageId         String
  moduleId        String
  versionId       String
  parentVersionId String?
  parentNodeIds   String[]     @default([])
  runId           String
  laneId          String
  attemptId       String
  createdBy       String
  createdAt       DateTime     @db.Timestamptz(6)
  payloadRef      String
  nodeStatus      String
  valueJudgement  Json?
  paper           PaperProject @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([paperId, nodeStatus])
}

model Snapshot {
  id                     String       @id
  paperId                String
  snapshotType           String
  spineType              String?
  nodeRefs               String[]     @default([])
  claimSetHash           String
  problemScopeHash       String
  datasetProtocolHash    String
  evaluationProtocolHash String
  createdAt              DateTime     @db.Timestamptz(6)
  createdBy              String
  paper                  PaperProject @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([paperId, snapshotType])
}

model LiteratureRecord {
  id                          String                                 @id
  title                       String
  abstractText                String?
  keyContentDigest            String?
  authors                     String[]                               @default([])
  year                        Int?
  doiNormalized               String?                                @unique
  arxivId                     String?                                @unique
  normalizedTitle             String
  titleAuthorsYearHash        String?                                @unique
  rightsClass                 String
  tags                        String[]                               @default([])
  activeEmbeddingVersionId    String?
  createdAt                   DateTime                               @db.Timestamptz(6)
  updatedAt                   DateTime                               @db.Timestamptz(6)
  sources                     LiteratureSource[]
  qualityAssessment           LiteratureQualityAssessment?
  citationProfile             LiteratureCitationProfile?
  abstractProfile             LiteratureAbstractProfile?
  contentAssets               LiteratureContentAsset[]
  fulltextDocuments           LiteratureFulltextDocument[]
  topicScopes                 TopicLiteratureScope[]
  paperLinks                  PaperLiteratureLink[]
  pipelineState               LiteraturePipelineState?
  pipelineStageStates         LiteraturePipelineStageState[]
  pipelineRuns                LiteraturePipelineRun[]
  pipelineArtifacts           LiteraturePipelineArtifact[]
  activeEmbeddingVersion      LiteratureEmbeddingVersion?            @relation("ActiveEmbeddingVersion", fields: [activeEmbeddingVersionId], references: [id], onDelete: SetNull)
  embeddingVersions           LiteratureEmbeddingVersion[]           @relation("LiteratureEmbeddingVersionOwner")
  embeddingChunks             LiteratureEmbeddingChunk[]
  embeddingTokenIndexes       LiteratureEmbeddingTokenIndex[]
  contentProcessingBatchItems LiteratureContentProcessingBatchItem[]
  fulltextAcquisitionItems    LiteratureFulltextAcquisitionItem[]
  autoPullSuggestions         AutoPullSuggestion[]
  titleCardSelections         TitleCardEvidenceSelection[]
  representativeClusters      LiteratureCluster[]                    @relation("LiteratureClusterRepresentative")
  clusterMemberships          LiteratureClusterMember[]
  clusterEvidenceAsA          LiteratureClusterEvidence[]            @relation("LiteratureClusterEvidenceA")
  clusterEvidenceAsB          LiteratureClusterEvidence[]            @relation("LiteratureClusterEvidenceB")

  @@index([normalizedTitle])
  @@index([activeEmbeddingVersionId])
}

model LiteratureQualityAssessment {
  id                String           @id
  literatureId      String           @unique
  qualityStatus     String
  qualityScore      Float?
  qualityComponents Json
  blockerCodes      String[]         @default([])
  source            String
  assessedAt        DateTime         @db.Timestamptz(6)
  createdAt         DateTime         @db.Timestamptz(6)
  updatedAt         DateTime         @db.Timestamptz(6)
  literature        LiteratureRecord @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@index([qualityStatus])
  @@index([assessedAt])
}

model LiteratureSource {
  id           String           @id
  literatureId String
  provider     String
  sourceItemId String
  sourceUrl    String
  rawPayload   Json
  fetchedAt    DateTime         @db.Timestamptz(6)
  literature   LiteratureRecord @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@unique([provider, sourceItemId])
  @@index([literatureId])
}

model LiteratureCitationProfile {
  id                    String           @id
  literatureId          String           @unique
  normalizedDoi         String?
  normalizedArxivId     String?
  normalizedTitle       String
  normalizedAuthors     String[]         @default([])
  parsedYear            Int?
  normalizedSourceUrl   String?
  titleAuthorsYearHash  String?
  citationComplete      Boolean          @default(false)
  incompleteReasonCodes String[]         @default([])
  sourceRefs            Json             @default("[]")
  inputChecksum         String
  confidence            Float            @default(0)
  createdAt             DateTime         @db.Timestamptz(6)
  updatedAt             DateTime         @db.Timestamptz(6)
  literature            LiteratureRecord @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@index([citationComplete])
  @@index([normalizedDoi])
  @@index([normalizedArxivId])
  @@index([titleAuthorsYearHash])
}

model LiteratureAbstractProfile {
  id             String           @id
  literatureId   String           @unique
  abstractText   String?
  abstractSource String?
  sourceRef      Json             @default("{}")
  checksum       String?
  language       String?
  confidence     Float            @default(0)
  reasonCodes    String[]         @default([])
  generated      Boolean          @default(false)
  createdAt      DateTime         @db.Timestamptz(6)
  updatedAt      DateTime         @db.Timestamptz(6)
  literature     LiteratureRecord @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@index([abstractSource])
  @@index([generated])
}

model LiteratureContentAsset {
  id               String                              @id
  literatureId     String
  assetKind        String
  sourceKind       String
  localPath        String
  checksum         String
  mimeType         String
  byteSize         Int
  rightsClass      String
  status           String
  metadata         Json                                @default("{}")
  createdAt        DateTime                            @db.Timestamptz(6)
  updatedAt        DateTime                            @db.Timestamptz(6)
  acquisitionItems LiteratureFulltextAcquisitionItem[]
  literature       LiteratureRecord                    @relation(fields: [literatureId], references: [id], onDelete: Cascade)
  fulltextDocument LiteratureFulltextDocument?

  @@unique([literatureId, localPath])
  @@index([literatureId, assetKind, status])
  @@index([checksum])
}

model LiteratureCluster {
  id                         String                      @id
  clusterType                String
  status                     String
  representativeLiteratureId String?
  confidence                 Float                       @default(0)
  method                     String
  createdAt                  DateTime                    @db.Timestamptz(6)
  updatedAt                  DateTime                    @db.Timestamptz(6)
  representative             LiteratureRecord?           @relation("LiteratureClusterRepresentative", fields: [representativeLiteratureId], references: [id], onDelete: SetNull)
  members                    LiteratureClusterMember[]
  evidence                   LiteratureClusterEvidence[]

  @@index([clusterType, status])
  @@index([representativeLiteratureId])
}

model LiteratureClusterMember {
  id             String            @id
  clusterId      String
  literatureId   String
  role           String
  relationType   String
  confidence     Float             @default(0)
  decisionStatus String
  createdAt      DateTime          @db.Timestamptz(6)
  updatedAt      DateTime          @db.Timestamptz(6)
  cluster        LiteratureCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  literature     LiteratureRecord  @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@unique([clusterId, literatureId])
  @@index([literatureId, decisionStatus])
  @@index([clusterId])
}

model LiteratureClusterEvidence {
  id            String            @id
  clusterId     String
  literatureIdA String
  literatureIdB String
  signalType    String
  score         Float             @default(0)
  payload       Json              @default("{}")
  createdAt     DateTime          @db.Timestamptz(6)
  cluster       LiteratureCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  literatureA   LiteratureRecord  @relation("LiteratureClusterEvidenceA", fields: [literatureIdA], references: [id], onDelete: Cascade)
  literatureB   LiteratureRecord  @relation("LiteratureClusterEvidenceB", fields: [literatureIdB], references: [id], onDelete: Cascade)

  @@unique([clusterId, literatureIdA, literatureIdB, signalType])
  @@index([clusterId])
  @@index([literatureIdA, literatureIdB])
  @@index([signalType])
}

model LiteratureFulltextDocument {
  id                     String                        @id
  literatureId           String
  sourceAssetId          String                        @unique
  normalizedText         String?
  normalizedTextPath     String?
  normalizedTextChecksum String
  parserName             String
  parserVersion          String
  parserArtifactPath     String?
  parserArtifactMimeType String?
  status                 String
  diagnostics            Json                          @default("[]")
  createdAt              DateTime                      @db.Timestamptz(6)
  updatedAt              DateTime                      @db.Timestamptz(6)
  literature             LiteratureRecord              @relation(fields: [literatureId], references: [id], onDelete: Cascade)
  sourceAsset            LiteratureContentAsset        @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)
  sections               LiteratureFulltextSection[]
  paragraphs             LiteratureFulltextParagraph[]
  anchors                LiteratureFulltextAnchor[]

  @@index([literatureId, status])
  @@index([normalizedTextChecksum])
}

model LiteratureFulltextSection {
  id          String                     @id
  documentId  String
  sectionId   String
  title       String
  level       Int
  orderIndex  Int
  startOffset Int
  endOffset   Int
  pageStart   Int?
  pageEnd     Int?
  checksum    String
  createdAt   DateTime                   @db.Timestamptz(6)
  updatedAt   DateTime                   @db.Timestamptz(6)
  document    LiteratureFulltextDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sectionId])
  @@index([documentId, orderIndex])
}

model LiteratureFulltextParagraph {
  id          String                     @id
  documentId  String
  paragraphId String
  sectionId   String
  orderIndex  Int
  text        String
  startOffset Int
  endOffset   Int
  pageNumber  Int?
  checksum    String
  confidence  Float                      @default(1)
  createdAt   DateTime                   @db.Timestamptz(6)
  updatedAt   DateTime                   @db.Timestamptz(6)
  document    LiteratureFulltextDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, paragraphId])
  @@index([documentId, orderIndex])
  @@index([documentId, sectionId])
}

model LiteratureFulltextAnchor {
  id         String                     @id
  documentId String
  anchorId   String
  anchorType String
  label      String?
  text       String?
  pageNumber Int?
  bbox       Json?
  targetRefs Json                       @default("[]")
  metadata   Json                       @default("{}")
  checksum   String?
  createdAt  DateTime                   @db.Timestamptz(6)
  updatedAt  DateTime                   @db.Timestamptz(6)
  document   LiteratureFulltextDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, anchorId])
  @@index([documentId, anchorType])
}

model TopicLiteratureScope {
  id               String           @id
  topicId          String
  literatureId     String
  scopeStatus      String
  reason           String?
  activationStatus String           @default("candidate")
  activationReason String?
  activationScore  Float?
  activatedAt      DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @db.Timestamptz(6)
  updatedAt        DateTime         @db.Timestamptz(6)
  literature       LiteratureRecord @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@unique([topicId, literatureId])
  @@index([topicId])
  @@index([topicId, activationStatus])
  @@index([literatureId, activationStatus])
}

model PaperLiteratureLink {
  id             String           @id
  paperId        String
  topicId        String?
  literatureId   String
  citationStatus String
  note           String?
  createdAt      DateTime         @db.Timestamptz(6)
  updatedAt      DateTime         @db.Timestamptz(6)
  paper          PaperProject     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  literature     LiteratureRecord @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@unique([paperId, literatureId])
  @@index([paperId])
  @@index([literatureId])
}

model LiteraturePipelineState {
  id               String           @id
  literatureId     String           @unique
  citationComplete Boolean          @default(false)
  abstractReady    Boolean          @default(false)
  keyContentReady  Boolean          @default(false)
  dedupStatus      String           @default("unknown")
  updatedAt        DateTime         @db.Timestamptz(6)
  literature       LiteratureRecord @relation(fields: [literatureId], references: [id], onDelete: Cascade)
}

model LiteraturePipelineRun {
  id              String                         @id
  literatureId    String
  triggerSource   String
  status          String
  requestedStages String[]                       @default([])
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime                       @db.Timestamptz(6)
  startedAt       DateTime?                      @db.Timestamptz(6)
  finishedAt      DateTime?                      @db.Timestamptz(6)
  updatedAt       DateTime                       @db.Timestamptz(6)
  literature      LiteratureRecord               @relation(fields: [literatureId], references: [id], onDelete: Cascade)
  steps           LiteraturePipelineRunStep[]
  stageStates     LiteraturePipelineStageState[]

  @@index([literatureId, createdAt])
  @@index([literatureId, status])
  @@index([status])
}

model LiteraturePipelineStageState {
  id           String                 @id
  literatureId String
  stageCode    String
  status       String
  lastRunId    String?
  detail       Json
  updatedAt    DateTime               @db.Timestamptz(6)
  literature   LiteratureRecord       @relation(fields: [literatureId], references: [id], onDelete: Cascade)
  lastRun      LiteraturePipelineRun? @relation(fields: [lastRunId], references: [id], onDelete: SetNull)

  @@unique([literatureId, stageCode])
  @@index([stageCode, status])
  @@index([lastRunId])
}

model LiteraturePipelineRunStep {
  id           String                @id
  runId        String
  stageCode    String
  status       String
  inputRef     Json
  outputRef    Json
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?             @db.Timestamptz(6)
  finishedAt   DateTime?             @db.Timestamptz(6)
  run          LiteraturePipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([stageCode, status])
}

model LiteraturePipelineArtifact {
  id           String           @id
  literatureId String
  stageCode    String
  artifactType String
  payload      Json
  payloadPath  String?
  checksum     String?
  createdAt    DateTime         @db.Timestamptz(6)
  updatedAt    DateTime         @db.Timestamptz(6)
  literature   LiteratureRecord @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@unique([literatureId, stageCode, artifactType])
  @@index([literatureId, stageCode])
  @@index([stageCode, artifactType])
}

model LiteratureEmbeddingVersion {
  id                        String                          @id
  literatureId              String
  versionNo                 Int
  status                    String                          @default("READY")
  profileId                 String?
  provider                  String
  model                     String
  dimension                 Int
  chunkCount                Int
  vectorCount               Int
  tokenCount                Int
  inputChecksum             String?
  chunkArtifactChecksum     String?
  embeddingArtifactChecksum String?
  indexArtifactChecksum     String?
  indexedAt                 DateTime?                       @db.Timestamptz(6)
  activatedAt               DateTime?                       @db.Timestamptz(6)
  createdAt                 DateTime                        @db.Timestamptz(6)
  updatedAt                 DateTime                        @db.Timestamptz(6)
  literature                LiteratureRecord                @relation("LiteratureEmbeddingVersionOwner", fields: [literatureId], references: [id], onDelete: Cascade)
  activeFor                 LiteratureRecord[]              @relation("ActiveEmbeddingVersion")
  chunks                    LiteratureEmbeddingChunk[]
  tokenIndexes              LiteratureEmbeddingTokenIndex[]

  @@unique([literatureId, versionNo])
  @@index([literatureId, createdAt])
  @@index([literatureId, status])
  @@index([provider, model, dimension])
}

model LiteratureEmbeddingChunk {
  id                 String                     @id
  embeddingVersionId String
  literatureId       String
  chunkId            String
  chunkIndex         Int
  text               String
  startOffset        Int
  endOffset          Int
  chunkType          String                     @default("fulltext_paragraph")
  sourceRefs         Json                       @default("[]")
  metadata           Json                       @default("{}")
  contentChecksum    String?
  vector             Json
  createdAt          DateTime                   @db.Timestamptz(6)
  updatedAt          DateTime                   @db.Timestamptz(6)
  embeddingVersion   LiteratureEmbeddingVersion @relation(fields: [embeddingVersionId], references: [id], onDelete: Cascade)
  literature         LiteratureRecord           @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@unique([embeddingVersionId, chunkId])
  @@index([embeddingVersionId, chunkIndex])
  @@index([literatureId, chunkId])
  @@index([literatureId, chunkType])
}

model LiteratureEmbeddingTokenIndex {
  id                 String                     @id
  embeddingVersionId String
  literatureId       String
  token              String
  chunkIds           String[]                   @default([])
  createdAt          DateTime                   @db.Timestamptz(6)
  updatedAt          DateTime                   @db.Timestamptz(6)
  embeddingVersion   LiteratureEmbeddingVersion @relation(fields: [embeddingVersionId], references: [id], onDelete: Cascade)
  literature         LiteratureRecord           @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@unique([embeddingVersionId, token])
  @@index([literatureId, token])
}

model LiteratureContentProcessingBatchJob {
  id             String                                 @id
  status         String
  targetStage    String
  workset        Json                                   @default("{}")
  options        Json                                   @default("{}")
  dryRunEstimate Json                                   @default("{}")
  totals         Json                                   @default("{}")
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                               @db.Timestamptz(6)
  startedAt      DateTime?                              @db.Timestamptz(6)
  pausedAt       DateTime?                              @db.Timestamptz(6)
  canceledAt     DateTime?                              @db.Timestamptz(6)
  finishedAt     DateTime?                              @db.Timestamptz(6)
  updatedAt      DateTime                               @db.Timestamptz(6)
  items          LiteratureContentProcessingBatchItem[]

  @@index([status, createdAt])
  @@index([updatedAt])
}

model LiteratureContentProcessingBatchItem {
  id              String                              @id
  jobId           String
  literatureId    String
  status          String
  requestedStages String[]                            @default([])
  nextStageIndex  Int                                 @default(0)
  pipelineRunId   String?
  attemptCount    Int                                 @default(0)
  errorCode       String?
  errorMessage    String?
  blockerCode     String?
  retryable       Boolean                             @default(true)
  checkpoint      Json                                @default("{}")
  createdAt       DateTime                            @db.Timestamptz(6)
  startedAt       DateTime?                           @db.Timestamptz(6)
  finishedAt      DateTime?                           @db.Timestamptz(6)
  updatedAt       DateTime                            @db.Timestamptz(6)
  job             LiteratureContentProcessingBatchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  literature      LiteratureRecord                    @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([literatureId, status])
  @@index([pipelineRunId])
  @@index([updatedAt])
}

model LiteratureFulltextAcquisitionJob {
  id             String                              @id
  status         String
  workset        Json                                @default("{}")
  options        Json                                @default("{}")
  dryRunEstimate Json                                @default("{}")
  totals         Json                                @default("{}")
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                            @db.Timestamptz(6)
  startedAt      DateTime?                           @db.Timestamptz(6)
  pausedAt       DateTime?                           @db.Timestamptz(6)
  canceledAt     DateTime?                           @db.Timestamptz(6)
  finishedAt     DateTime?                           @db.Timestamptz(6)
  updatedAt      DateTime                            @db.Timestamptz(6)
  items          LiteratureFulltextAcquisitionItem[]

  @@index([status, createdAt])
  @@index([updatedAt])
}

model LiteratureFulltextAcquisitionItem {
  id                   String                           @id
  jobId                String
  literatureId         String
  status               String
  selectedSourceKind   String?
  sourceUrl            String?
  finalUrl             String?
  contentAssetId       String?
  attemptCount         Int                              @default(0)
  errorCode            String?
  errorMessage         String?
  blockerCode          String?
  retryable            Boolean                          @default(true)
  resolutionCandidates Json                             @default("[]")
  checkpoint           Json                             @default("{}")
  createdAt            DateTime                         @db.Timestamptz(6)
  startedAt            DateTime?                        @db.Timestamptz(6)
  finishedAt           DateTime?                        @db.Timestamptz(6)
  updatedAt            DateTime                         @db.Timestamptz(6)
  contentAsset         LiteratureContentAsset?          @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  job                  LiteratureFulltextAcquisitionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  literature           LiteratureRecord                 @relation(fields: [literatureId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([literatureId, status])
  @@index([contentAssetId])
  @@index([updatedAt])
}

model LiteratureSourceRuntimeState {
  id               String    @id
  source           String
  status           String
  cooldownUntil    DateTime? @db.Timestamptz(6)
  failureCount     Int       @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  lastRequestAt    DateTime? @db.Timestamptz(6)
  lastSuccessAt    DateTime? @db.Timestamptz(6)
  lastFailureAt    DateTime? @db.Timestamptz(6)
  metadata         Json      @default("{}")
  createdAt        DateTime  @db.Timestamptz(6)
  updatedAt        DateTime  @db.Timestamptz(6)

  @@unique([source])
  @@index([status, cooldownUntil])
  @@index([updatedAt])
}

model ApplicationSetting {
  id          String   @id
  namespace   String
  key         String
  value       Json
  secretValue String?
  createdAt   DateTime @db.Timestamptz(6)
  updatedAt   DateTime @db.Timestamptz(6)

  @@unique([namespace, key])
  @@index([namespace])
}

model TopicProfile {
  id                  String               @id
  name                String
  isActive            Boolean              @default(true)
  initialPullPending  Boolean              @default(false)
  includeKeywords     String[]             @default([])
  excludeKeywords     String[]             @default([])
  venueFilters        String[]             @default([])
  defaultLookbackDays Int                  @default(30)
  defaultMinYear      Int?
  defaultMaxYear      Int?
  createdAt           DateTime             @db.Timestamptz(6)
  updatedAt           DateTime             @db.Timestamptz(6)
  ruleLinks           AutoPullRuleTopic[]
  suggestions         AutoPullSuggestion[]
}

model AutoPullRule {
  id          String                 @id
  scope       String
  name        String
  status      String
  querySpec   Json
  timeSpec    Json
  qualitySpec Json
  createdAt   DateTime               @db.Timestamptz(6)
  updatedAt   DateTime               @db.Timestamptz(6)
  topics      AutoPullRuleTopic[]
  sources     AutoPullRuleSource[]
  schedules   AutoPullRuleSchedule[]
  runs        AutoPullRun[]
  cursors     AutoPullCursor[]
  alerts      AutoPullAlert[]

  @@index([scope, status])
}

model AutoPullRuleTopic {
  id        String       @id
  ruleId    String
  topicId   String
  createdAt DateTime     @db.Timestamptz(6)
  rule      AutoPullRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  topic     TopicProfile @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([ruleId, topicId])
  @@index([topicId])
  @@index([ruleId])
}

model AutoPullRuleSource {
  id       String       @id
  ruleId   String
  source   String
  enabled  Boolean      @default(true)
  priority Int          @default(100)
  config   Json
  rule     AutoPullRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, source])
  @@index([ruleId])
}

model AutoPullRuleSchedule {
  id         String       @id
  ruleId     String
  frequency  String
  daysOfWeek String[]     @default([])
  hour       Int
  minute     Int
  timezone   String
  active     Boolean      @default(true)
  rule       AutoPullRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model AutoPullRun {
  id             String                     @id
  ruleId         String
  triggerType    String
  status         String
  startedAt      DateTime?                  @db.Timestamptz(6)
  finishedAt     DateTime?                  @db.Timestamptz(6)
  summary        Json
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                   @db.Timestamptz(6)
  updatedAt      DateTime                   @db.Timestamptz(6)
  rule           AutoPullRule               @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sourceAttempts AutoPullRunSourceAttempt[]
  alerts         AutoPullAlert[]
  suggestions    AutoPullSuggestion[]

  @@index([ruleId, status])
  @@index([createdAt])
}

